# Dify SSRF 代理配置
# 允许访问的私网IP段（CIDR格式，逗号分隔）
# 必须填具体网段，不能填 true，否则 Squid 会崩溃
# 根据实际 Docker 网络环境调整
SSRF_PROXY_ALLOW_PRIVATE_IPS=172.28.0.0/16,127.0.0.1/32,192.168.0.0/16,172.17.0.0/16

# Mock API 地址（Dify HTTP请求节点使用）
# Docker内访问宿主机用 WSL2网关IP，根据实际网络调整
# 查看方式：在Dify容器内执行 curl http://host.docker.internal:3000/
MOCK_API_URL=http://host.docker.internal:3000

# 通义千问 API Key（在 https://dashscope.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=your_api_key_here
